<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sicherheitsbericht {{ summary.target_name }}</title>
<style>
  :root { --ink:#1f2937; --muted:#6b7280; --line:#e5e7eb; --bg:#f3f4f6; --card:#ffffff; }
  * { box-sizing: border-box; }
  body { margin:0; padding:32px 16px; background:var(--bg); color:var(--ink);
         font-family: "Segoe UI", system-ui, -apple-system, Helvetica, Arial, sans-serif; line-height:1.5; }
  main { max-width:960px; margin:0 auto; }
  header, section { background:var(--card); border:1px solid var(--line); border-radius:12px;
                    padding:24px 28px; margin-bottom:20px; }
  h1 { margin:0 0 4px; font-size:1.6rem; }
  h2 { margin:0 0 12px; font-size:1.15rem; }
  .meta { color:var(--muted); font-size:.92rem; margin:0; }
  .meta span { margin-right:18px; }
  .overall { display:flex; align-items:center; gap:18px; flex-wrap:wrap; }
  .big { font-size:2.4rem; font-weight:700; }
  .note { color:var(--muted); font-size:.9rem; margin:10px 0 0; }
  .abort { background:#fef2f2; border:1px solid #fca5a5; color:#991b1b; border-radius:12px;
           padding:16px 20px; margin-bottom:20px; font-weight:600; }
  .badge { display:inline-block; padding:2px 10px; border-radius:999px; font-size:.85rem;
           font-weight:600; border:1px solid transparent; }
  .gruen { background:#dcfce7; color:#166534; border-color:#86efac; }
  .gelb { background:#fef9c3; color:#854d0e; border-color:#fde047; }
  .rot { background:#fee2e2; color:#991b1b; border-color:#fca5a5; }
  .grau { background:#e5e7eb; color:#374151; border-color:#d1d5db; }
  table { width:100%; border-collapse:collapse; font-size:.95rem; }
  th, td { padding:10px 8px; text-align:left; border-bottom:1px solid var(--line); }
  th { color:var(--muted); font-weight:600; font-size:.85rem; }
  td.num, th.num { text-align:right; }
  .example { border-left:4px solid #fca5a5; padding:4px 0 4px 16px; margin-bottom:22px; }
  .example h3 { margin:0 0 8px; font-size:1rem; }
  .label { color:var(--muted); font-size:.8rem; font-weight:600; text-transform:uppercase;
           letter-spacing:.04em; margin:12px 0 4px; }
  pre { margin:0 0 6px; padding:10px 12px; background:#f9fafb; border:1px solid var(--line);
        border-radius:8px; white-space:pre-wrap; word-wrap:break-word; font-family:Consolas, monospace;
        font-size:.88rem; }
  .tip { background:#eff6ff; border:1px solid #bfdbfe; color:#1e3a8a; border-radius:8px;
         padding:10px 14px; margin-top:12px; }
</style>
</head>
<body>
<main>
  <header>
    <h1>Sicherheitsbericht: {{ summary.target_name }}</h1>
    <p class="meta">
      <span>Lauf {{ summary.run_id }}</span>
      <span>Gestartet: {{ summary.started }}</span>
      <span>Beendet: {{ summary.finished if summary.finished else "keine Angabe" }}</span>
    </p>
  </header>

  {% if summary.aborted %}
  <div class="abort">Lauf abgebrochen: {{ summary.abort_reason if summary.abort_reason else "kein Grund angegeben" }}</div>
  {% endif %}

  <section>
    <h2>Abwehrquote gesamt</h2>
    <div class="overall">
      <span class="big">{{ overall_rate }}</span>
      <span class="badge {{ overall_light }}">{{ overall_light_word }}</span>
      <span class="meta">Veränderung zum letzten Lauf: {{ overall_delta }}</span>
    </div>
    <p class="note">Die Quote zählt nur eindeutige Ergebnisse. „Nicht bewertet“ und „unklar“ zählen nie als abgewehrt.</p>
  </section>

  <section>
    <h2>Ergebnis pro Kategorie</h2>
    <table>
      <thead>
        <tr>
          <th>Kategorie</th><th class="num">Treffer</th><th class="num">Abgewehrt</th>
          <th class="num">Unklar</th><th class="num">Nicht bewertet</th>
          <th class="num">Abwehrquote</th><th>Ampel</th><th>Veränderung</th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
        <tr>
          <td>{{ row.name }}</td>
          <td class="num">{{ row.score.success }}</td>
          <td class="num">{{ row.score.blocked }}</td>
          <td class="num">{{ row.score.unclear }}</td>
          <td class="num">{{ row.score.not_evaluated }}</td>
          <td class="num">{{ row.rate }}</td>
          <td><span class="badge {{ row.score.light }}">{{ row.light_word }}</span></td>
          <td>{{ row.delta }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  {% for row in rows if row.tip %}
  <section>
    <h2>{{ row.name }}: Beispiel und Tipp</h2>
    {% if row.example %}
    <div class="example">
      <h3>Angriff {{ row.example.attack_id }}</h3>
      <div class="label">Nachrichten an den Chatbot</div>
      {% for msg in row.example.user_messages %}<pre>{{ msg }}</pre>{% endfor %}
      <div class="label">Antwort des Chatbots</div>
      <pre>{{ row.example.response }}</pre>
      <div class="label">Urteil</div>
      <p>{{ row.example.verdict }}, entschieden durch {{ row.example.decided_by }}: {{ row.example.reason }}</p>
    </div>
    {% endif %}
    <div class="tip"><strong>Tipp:</strong> {{ row.tip }}</div>
  </section>
  {% endfor %}
</main>
</body>
</html>
